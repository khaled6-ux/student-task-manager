# Copy to backend/.env. Never commit actual connection strings or tokens.
APP_NAME=Student Task Manager
CORS_ORIGINS=["http://localhost:5173"]
# Required for /api/v1 data routes; /health remains database-independent.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# HTTPS project origin; verifier derives issuer and public JWKS endpoint from this.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# No JWT signing secret, service-role key, or Google credential is used by this backend.
# Only for PostgreSQL integration tests; use a disposable database, never production.
# TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/TEST_DATABASE

# Browser-only public Supabase values are documented in frontend/.env.example.
# Never copy database credentials, signing secrets, or service-role keys into VITE_ variables.

# Opt-in development diagnostics only; leave disabled outside local development.
APP_ENV=development
DEV_PERFORMANCE_TIMING=false

# Per-process pool is capped at 10 connections; configure total workers accordingly.
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=3000
# Production settings and mandatory TLS: config/production.backend.env.example
