# Public browser configuration only. Never use a service-role/secret key here.
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Explicit development-only mock workspace; false by default. No API fallback.
VITE_DEMO_MODE=false
# Optional redacted browser timing logs, active only under the Vite development server.
VITE_DEV_PERF_TIMING=false
