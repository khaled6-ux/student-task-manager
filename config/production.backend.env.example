# Example only. Inject values through the hosting secret manager, not Git.
APP_ENV=production
APP_NAME=Student Task Manager
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
CORS_ORIGINS=["https://app.example.com"]
# Private. Percent-encode the real password; use direct or session pooler mode.
# Provide the appropriate trusted CA bundle at this path; never disable verification.
DATABASE_URL=postgresql+psycopg://RUNTIME_USER:ENCODED_PASSWORD@DB_HOST:5432/DATABASE?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=3000
DEV_PERFORMANCE_TIMING=false
# No service-role key, signing secret, or Google client secret is required by FastAPI.
